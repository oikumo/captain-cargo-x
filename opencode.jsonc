{
  "$schema": "https://opencode.ai/config.json",
  // Git transport policy — spec/meta-harness.md §3 (v1.3): `git commit` is
  // ALWAYS allowed; the agent never pushes; remotes are origin-only.
  // Ordered rules, last match wins; unmatched actions stay allow-by-default.
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git remote add *", "effect": "deny" },
    { "action": "shell", "resource": "git remote set-url *", "effect": "deny" },
    { "action": "shell", "resource": "git remote remove *", "effect": "deny" },
    { "action": "shell", "resource": "git remote rename *", "effect": "deny" },
    { "action": "shell", "resource": "git remote delete *", "effect": "deny" },
    { "action": "shell", "resource": "git submodule add *", "effect": "deny" },
    { "action": "shell", "resource": "git submodule update *", "effect": "deny" },
    { "action": "shell", "resource": "git clone *", "effect": "deny" },
    // config-layer smuggling of a non-origin remote:
    { "action": "shell", "resource": "git config --local remote.*", "effect": "deny" },
    { "action": "shell", "resource": "git config remote.*", "effect": "deny" },
    // remote fetch/pull sources other than origin (URL forms):
    { "action": "shell", "resource": "git fetch http*://*", "effect": "deny" },
    { "action": "shell", "resource": "git fetch git://*", "effect": "deny" },
    { "action": "shell", "resource": "git fetch ssh://*", "effect": "deny" },
    { "action": "shell", "resource": "git fetch git@*", "effect": "deny" },
    { "action": "shell", "resource": "git pull http*://*", "effect": "deny" },
    { "action": "shell", "resource": "git pull git://*", "effect": "deny" },
    { "action": "shell", "resource": "git pull ssh://*", "effect": "deny" },
    { "action": "shell", "resource": "git pull git@*", "effect": "deny" }
  ]
}
